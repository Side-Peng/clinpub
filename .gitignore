# clinpub .gitignore

# Raw data — never commit patient data
01_RawData/
01_RawData/*.csv
01_RawData/*.xlsx
01_RawData/*.xls
01_RawData/*.sav
01_RawData/*.dta
01_RawData/*.sas7bdat

# Preprocessed data
02_PreprocessedData/data/

# Generated outputs (large files)
04_Outputs/**/*.png
04_Outputs/**/*.tiff
04_Outputs/**/*.pdf
03_AnalysisMethods/**/main.R
!03_AnalysisMethods/**/方法说明.md

# API keys and secrets
.env
.env.*
*.key
secrets.json

# R session artifacts
.Rhistory
.RData
.Rproj.user/
*.Rproj
.Rprofile

# Python artifacts
__pycache__/
*.pyc
*.pyo
.idea/
*.egg-info/

# Node artifacts
node_modules/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Planning working files (keep structure, ignore drafts)
.clinpub/phases/**/*-draft.md

# Project state, IDE knowledge base & AI config (not for git)
.clinpub/
.claude/
.solomd/
CLAUDE.md

# DeepSeek Harness：.dsh/skills/ 是构建产物，但 DSH 靠它发现技能，必须提交。
# 生成源与校验见 dsh/build.mjs（node dsh/build.mjs --check）。运行态在 ~/.dsh，不入库。

# NCBI 检索缓存（ncbi-search v3 自动生成，不入库）
.ncbi_cache/

# Dev working files
开发日志.md

# Logs
*.log

# Release artifacts (generated by CI)
*.tar.gz
checksums.txt

# 测试工程：样式探索与位图预览不入库（可用 CLINPUB_FIG_PREVIEW=1 重新生成）
test/figstyle/
test/04_Outputs/**/*.png
test/04_Outputs/**/*.tiff
test/05_Manuscript/*.docx
Rplots.pdf
